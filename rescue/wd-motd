#!/bin/sh
# wd-motd - render /etc/issue and /etc/motd for this NAS.
# Usage: wd-motd [wordmark|box|tux|tux2|minimal]   (persisted in /etc/wd-motd.style)
set -u
STYLE=${1:-$(cat /etc/wd-motd.style 2>/dev/null || echo box)}
HOST=$(hostname 2>/dev/null || echo wdmycloud)
KERNEL=$(uname -r 2>/dev/null || echo unknown)
IP=$(ip -o -4 addr show dev eth0 2>/dev/null | awk '{print $4; exit}')
[ -n "${IP:-}" ] || IP="no link"
TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
if [ -n "${TEMP:-}" ]; then TEMP=$((TEMP/1000)); else TEMP="?"; fi
FAN=$(for h in /sys/class/hwmon/hwmon*; do [ "$(cat "$h/name" 2>/dev/null)" = gpio_fan ] && cat "$h/fan1_input" 2>/dev/null && break; done)
[ -n "${FAN:-}" ] || FAN="?"
RAID=$(grep -oE 'UU|\[U+_|\[____\]' /proc/mdstat 2>/dev/null | head -1)
[ -n "${RAID:-}" ] || RAID="--"
UP=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
UPH=$((UP/3600)); UPM=$(((UP%3600)/60))
if [ "$UPH" -gt 0 ]; then UPTXT="${UPH}h ${UPM}m"; else UPTXT="${UPM}m"; fi

C0='\033[0m'; C1='\033[1;36m'; C2='\033[1;32m'; C3='\033[1;33m'
C6='\033[1;37m'; C7='\033[0;37m'
CREDIT='Custom build by ImAthanasia - github.com/ImAthanasia'
OUT=${WD_MOTD_OUT:-/etc/motd}

case "$STYLE" in
wordmark)
  {
    printf '%b' "${C6}       ▄▄▄▄▄▄▄${C0}\n"
    printf '%b' "${C6}      █  ▀▀▀  █${C0}\n"
    printf '%b' "${C6}      █  ███  █${C0}\n"
    printf '%b' "${C6}      █  ███  █${C0}\n"
    printf '%b' "${C6}       █▄▄▄▄▄█${C0}\n"
    printf '%b' "${C3}  WD My Cloud EX2  ${HOST}${C0}\n"
    printf '%b' "${C7}  Debian 12 armhf / kernel ${KERNEL}${C0}\n"
    printf '%b' "${C3}  ${CREDIT}${C0}\n"
  } > "$OUT"
  ;;
tux)
  {
    printf '%b' "${C1}        .-\"\"\"\"\"\"-.\n"
    printf '%b' "       /  .--.    \\\\\n"
    printf '%b' "      |  /    \\\\    |\n"
    printf '%b' "      | |  ()  |   |\n"
    printf '%b' "      |  \\\\____/    |\n"
    printf '%b' "       \\\\  ____    /\n"
    printf '%b' "        '-.__.-'${C0}\n"
    printf '%b' "${C2}   W D   E X 2   //   N A S\n"
    printf '%b' "${C7}   kernel ${KERNEL}  ·  ${HOST}  ·  ${IP}\n"
    printf '%b' "${C3}   ${CREDIT}${C0}\n"
  } > "$OUT"
  ;;
tux2)
  {
    printf '%b' "${C1}"
    cat <<'TUX'
        .--.
       |o_o |
       |:_/ |
      //   \ \
     (|     | )
    /'\_   _/`\
    \___)=(___/
TUX
    printf '%b' "${C0}"
    printf '%b' "${C2}   W D   E X 2   //   N A S //  TUX EDITION\n"
    printf '%b' "${C7}   kernel ${KERNEL}  ·  ${HOST}  ·  ${IP}\n"
    printf '%b' "${C7}   ${TEMP}°C · fan ${FAN} rpm · RAID1 ${RAID} · up ${UPTXT}\n"
    printf '%b' "${C3}   ${CREDIT}${C0}\n"
  } > "$OUT"
  ;;
minimal)
  {
    printf '%b' "${C2}${HOST}${C0} ${C7}· Debian 12 · ${KERNEL}${C0} · ${IP} · ${TEMP}°C · RAID ${RAID} · up ${UPTXT}\n"
  } > "$OUT"
  ;;
box|*)
  {
    printf '%b' "${C1}┌─${C0} ${C6}WD My Cloud EX2${C0} ${C1}────────────────────────────────┐${C0}\n"
    printf '%b' "${C1}│${C0} host   ${C6}${HOST}${C0}\n"
    printf '%b' "${C1}│${C0} kernel ${KERNEL}  ·  Debian 12 armhf\n"
    printf '%b' "${C1}│${C0} net    ${IP}\n"
    printf '%b' "${C1}│${C0} health ${TEMP}°C · fan ${FAN} rpm · RAID1 ${RAID} · up ${UPTXT}\n"
    printf '%b' "${C1}└──────────────────────────────────────────────┘${C0}\n"
    printf '%b' "${C3}  ${CREDIT}${C0}\n"
  } > "$OUT"
  ;;
esac

if [ -z "${WD_MOTD_OUT:-}" ]; then
  cp -f "$OUT" /etc/issue 2>/dev/null || true
  printf '  login: root\n\n' >> /etc/issue 2>/dev/null
  printf '%s\n' "$STYLE" > /etc/wd-motd.style 2>/dev/null
fi
cat "$OUT"
